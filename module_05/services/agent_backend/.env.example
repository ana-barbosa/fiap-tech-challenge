CRM_BASE_URL=http://crm:8000
CHROMA_PATH=/data/chroma
TELEGRAM_BOT_INTERNAL_URL=http://telegram_bot:8090
# Public (browser-facing) base URL for the website, used only to build clickable
# listing links in chat replies - not used for server-to-server calls.
WEBSITE_PUBLIC_URL=http://localhost:8501

DB_PATH=/app/db/conversations.sqlite
# Conversations with no activity for this many days are treated as new on next contact.
CONVERSATION_RETENTION_DAYS=60
# Only the last N messages of a conversation's history are kept when persisting.
CONVERSATION_HISTORY_LIMIT=30

# Demo-vs-production tuning split, same pattern as ETL_POLL_INTERVAL_SECONDS: short values
# here make the follow-up nudge demoable in minutes instead of days.
FOLLOWUP_INACTIVITY_SECONDS=120
FOLLOWUP_POLL_INTERVAL_SECONDS=30

# Same demo-vs-production tuning split, for the broker-summary background loop.
SUMMARY_IDLE_SECONDS=60
SUMMARY_POLL_INTERVAL_SECONDS=30

# Abuse protection on /chat (security differentiator): at most this many requests per
# conversation_id within the rolling window below.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
