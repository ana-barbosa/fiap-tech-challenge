# Copy to .env and fill in. .env is gitignored - never commit real tokens.

# Needed by services/audio/src/transcription.py for pyannote.audio diarization.
# NOTE: a token alone is not enough - pyannote/speaker-diarization-community-1 is a
# gated model, so you must first visit its page while logged in to huggingface.co
# (https://huggingface.co/pyannote/speaker-diarization-community-1) and click "Agree
# and access repository" before a token can download it. Only then create a token at
# huggingface.co/settings/tokens.
HF_TOKEN=hf_xxxxxxxxxxxx
